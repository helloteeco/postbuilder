# Post Builder — Environment Variables
# Copy this to .env.local and fill in your values

# ── Anthropic (required) ──
# Get from https://console.anthropic.com — used to analyze competitor posts
# and generate your carousels.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Instagram oEmbed (optional) ──
# Lets the post builder resolve Instagram URLs via the official oEmbed API.
# Create a Meta app (free) and paste the access token here. If missing, the
# app falls back to public scraping, then to a "paste screenshots" prompt.
INSTAGRAM_OEMBED_TOKEN=

# ── ScrapingBee (optional, but recommended for Overlay Studio) ──
# Lets the Overlay Studio "From an Airbnb listing" importer pull the full
# Show all photos gallery (~30 photos) instead of just the hero shot.
# Airbnb hides the gallery behind client-side JS, so we need a headless-
# browser proxy. Sign up at https://www.scrapingbee.com — the free tier
# gives 1,000 API credits/month; each Airbnb listing costs ~25 credits
# (premium proxy + JS rendering), so the free tier covers ~40 listings/mo.
# Without this key the importer falls back to a direct fetch and usually
# returns only 1 photo.
SCRAPINGBEE_API_KEY=

# Post Builder — Environment Variables
# Copy this to .env.local and fill in your values

# ── Anthropic (required) ──
# Get from https://console.anthropic.com — used to analyze competitor posts
# and generate your carousels.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Instagram oEmbed (optional) ──
# Lets the post builder resolve Instagram URLs via the official oEmbed API.
# Create a Meta app (free) and paste the access token here. If missing, the
# app falls back to public scraping, then to a "paste screenshots" prompt.
INSTAGRAM_OEMBED_TOKEN=

# ── ScrapingBee (optional fallback for Overlay Studio) ──
# The Airbnb importer tries Airbnb's own v2 REST API first (free, hits
# their public web API key). That works for most listings. If a listing
# returns nothing — Airbnb sometimes blocks server IPs by region — set
# this and the route will retry through ScrapingBee's headless-Chrome
# proxy. Sign up at https://www.scrapingbee.com — free tier gives 1,000
# credits/month (~40 Airbnb listings).
SCRAPINGBEE_API_KEY=
